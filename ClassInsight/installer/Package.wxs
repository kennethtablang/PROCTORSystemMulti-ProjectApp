<!--
  ClassInsight Agent MSI. Mirrors deploy\Install-Agent.ps1:
   * installs into %ProgramFiles%\ClassInsight (admin-only writable by default ACL),
   * registers the "ClassInsightAgent" service: Automatic start, LocalSystem, restart on failure
     (5 s, 5 s, then 10 s; failure count reset daily) - FR-AGENT-02/07,
   * pre-creates %ProgramData%\ClassInsight (agent install id) with a protected ACL
     (Administrators/SYSTEM full, Users read) - FR-SEC-07,
   * upgrades in place (MajorUpgrade) and starts the service at the end of install.
  The service then launches the monitor inside the signed-in student's session (see README).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="ClassInsight Agent"
           Manufacturer="ClassInsight"
           Version="0.3.1"
           UpgradeCode="6F1C2B9E-3A4D-4E5F-9A8B-0C1D2E3F4A5B"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer ClassInsight Agent is already installed." />

    <!-- Install-time agent settings, e.g.
           msiexec /i ClassInsight.Agent.msi SERVERFINGERPRINT="1056 91B5 ..." SERVERADDRESS=10.0.0.5 /qn
         Each given value is written to classinsight.ini next to the agent (read on top of
         appsettings.json) and remembered in HKLM\Software\ClassInsight\Agent, so a later upgrade
         run without the properties keeps them. -->
    <!-- Lab enrolment key (NFR-SEC-06): kept only in an admin-only registry key, never in a settings
         file students can read, and hidden from installer logs. -->
    <Property Id="ENROLLMENTKEY" Secure="yes" Hidden="yes" />
    <Property Id="SAVED_ENROLLMENTKEY" Hidden="yes">
      <RegistrySearch Id="FindEnrollmentKey" Root="HKLM" Key="Software\ClassInsight\Agent\Secret" Name="EnrollmentKey" Type="raw" />
    </Property>
    <SetProperty Id="ENROLLMENTKEY" Value="[SAVED_ENROLLMENTKEY]" After="AppSearch" Sequence="first"
                 Condition="NOT ENROLLMENTKEY AND SAVED_ENROLLMENTKEY" />
    <Property Id="SERVERFINGERPRINT" Secure="yes" />
    <Property Id="SAVED_SERVERFINGERPRINT">
      <RegistrySearch Id="FindServerFingerprint" Root="HKLM" Key="Software\ClassInsight\Agent" Name="ServerFingerprint" Type="raw" />
    </Property>
    <SetProperty Id="SERVERFINGERPRINT" Value="[SAVED_SERVERFINGERPRINT]" After="AppSearch" Sequence="first"
                 Condition="NOT SERVERFINGERPRINT AND SAVED_SERVERFINGERPRINT" />
    <Property Id="SERVERADDRESS" Secure="yes" />
    <Property Id="SAVED_SERVERADDRESS">
      <RegistrySearch Id="FindServerAddress" Root="HKLM" Key="Software\ClassInsight\Agent" Name="ServerAddress" Type="raw" />
    </Property>
    <SetProperty Id="SERVERADDRESS" Value="[SAVED_SERVERADDRESS]" After="AppSearch" Sequence="first"
                 Condition="NOT SERVERADDRESS AND SAVED_SERVERADDRESS" />
    <Property Id="ROOMNAME" Secure="yes" />
    <Property Id="SAVED_ROOMNAME">
      <RegistrySearch Id="FindRoomName" Root="HKLM" Key="Software\ClassInsight\Agent" Name="RoomName" Type="raw" />
    </Property>
    <SetProperty Id="ROOMNAME" Value="[SAVED_ROOMNAME]" After="AppSearch" Sequence="first"
                 Condition="NOT ROOMNAME AND SAVED_ROOMNAME" />
    <Property Id="ALLOWREMOTECONTROL" Secure="yes" />
    <Property Id="SAVED_ALLOWREMOTECONTROL">
      <RegistrySearch Id="FindAllowRemoteControl" Root="HKLM" Key="Software\ClassInsight\Agent" Name="AllowRemoteControl" Type="raw" />
    </Property>
    <SetProperty Id="ALLOWREMOTECONTROL" Value="[SAVED_ALLOWREMOTECONTROL]" After="AppSearch" Sequence="first"
                 Condition="NOT ALLOWREMOTECONTROL AND SAVED_ALLOWREMOTECONTROL" />
    <Property Id="SHOWVIEWINGINDICATOR" Secure="yes" />
    <Property Id="SAVED_SHOWVIEWINGINDICATOR">
      <RegistrySearch Id="FindShowViewingIndicator" Root="HKLM" Key="Software\ClassInsight\Agent" Name="ShowViewingIndicator" Type="raw" />
    </Property>
    <SetProperty Id="SHOWVIEWINGINDICATOR" Value="[SAVED_SHOWVIEWINGINDICATOR]" After="AppSearch" Sequence="first"
                 Condition="NOT SHOWVIEWINGINDICATOR AND SAVED_SHOWVIEWINGINDICATOR" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ClassInsight">

        <Component Id="AgentService" Guid="*">
          <File Id="AgentExe" Source="$(var.AgentDir)ClassInsight.Agent.exe" KeyPath="yes" />
          <ServiceInstall Id="AgentServiceInstall"
                          Name="ClassInsightAgent"
                          DisplayName="ClassInsight Agent"
                          Description="ClassInsight classroom monitoring agent for institution-owned lab PCs."
                          Type="ownProcess"
                          Start="auto"
                          Account="LocalSystem"
                          ErrorControl="normal"
                          Vital="yes">
            <util:ServiceConfig FirstFailureActionType="restart"
                                SecondFailureActionType="restart"
                                ThirdFailureActionType="restart"
                                RestartServiceDelayInSeconds="5"
                                ResetPeriodInDays="1" />
          </ServiceInstall>
          <ServiceControl Id="AgentServiceControl"
                          Name="ClassInsightAgent"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>

        <Component Id="AgentSettings" Guid="*" NeverOverwrite="yes">
          <!-- Per-lab settings (RoomName, ServerAddress, ...). NeverOverwrite keeps an admin's
               edits across upgrades. -->
          <File Id="AgentAppSettings" Source="$(var.AgentDir)appsettings.json" KeyPath="yes" />
        </Component>

        <Component Id="SettingEnrollmentKey" Condition="ENROLLMENTKEY">
          <RegistryKey Root="HKLM" Key="Software\ClassInsight\Agent\Secret" ForceCreateOnInstall="yes">
            <PermissionEx Sddl="O:BAG:SYD:PAI(A;;KA;;;SY)(A;;KA;;;BA)" />
            <RegistryValue Name="EnrollmentKey" Type="string" Value="[ENROLLMENTKEY]" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="SettingServerFingerprint" Condition="SERVERFINGERPRINT">
          <RegistryValue Root="HKLM" Key="Software\ClassInsight\Agent" Name="ServerFingerprint" Type="string" Value="[SERVERFINGERPRINT]" KeyPath="yes" />
          <IniFile Id="IniServerFingerprint" Action="addLine" Directory="INSTALLFOLDER" Name="classinsight.ini"
                   Section="ClassInsight" Key="ServerFingerprint" Value="[SERVERFINGERPRINT]" />
        </Component>
        <Component Id="SettingServerAddress" Condition="SERVERADDRESS">
          <RegistryValue Root="HKLM" Key="Software\ClassInsight\Agent" Name="ServerAddress" Type="string" Value="[SERVERADDRESS]" KeyPath="yes" />
          <IniFile Id="IniServerAddress" Action="addLine" Directory="INSTALLFOLDER" Name="classinsight.ini"
                   Section="ClassInsight" Key="ServerAddress" Value="[SERVERADDRESS]" />
        </Component>
        <Component Id="SettingRoomName" Condition="ROOMNAME">
          <RegistryValue Root="HKLM" Key="Software\ClassInsight\Agent" Name="RoomName" Type="string" Value="[ROOMNAME]" KeyPath="yes" />
          <IniFile Id="IniRoomName" Action="addLine" Directory="INSTALLFOLDER" Name="classinsight.ini"
                   Section="ClassInsight" Key="RoomName" Value="[ROOMNAME]" />
        </Component>
        <Component Id="SettingAllowRemoteControl" Condition="ALLOWREMOTECONTROL">
          <RegistryValue Root="HKLM" Key="Software\ClassInsight\Agent" Name="AllowRemoteControl" Type="string" Value="[ALLOWREMOTECONTROL]" KeyPath="yes" />
          <IniFile Id="IniAllowRemoteControl" Action="addLine" Directory="INSTALLFOLDER" Name="classinsight.ini"
                   Section="ClassInsight" Key="AllowRemoteControl" Value="[ALLOWREMOTECONTROL]" />
        </Component>
        <Component Id="SettingShowViewingIndicator" Condition="SHOWVIEWINGINDICATOR">
          <RegistryValue Root="HKLM" Key="Software\ClassInsight\Agent" Name="ShowViewingIndicator" Type="string" Value="[SHOWVIEWINGINDICATOR]" KeyPath="yes" />
          <IniFile Id="IniShowViewingIndicator" Action="addLine" Directory="INSTALLFOLDER" Name="classinsight.ini"
                   Section="ClassInsight" Key="ShowViewingIndicator" Value="[SHOWVIEWINGINDICATOR]" />
        </Component>

      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="STATEFOLDER" Name="ClassInsight">
        <Component Id="StateFolder" Guid="0D7E4C1A-2B3F-4A5E-8C6D-7E8F9A0B1C2D">
          <CreateFolder>
            <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)(A;OICI;0x1200a9;;;BU)" />
          </CreateFolder>
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Agent" Title="ClassInsight Agent" Level="1">
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="AgentSettings" />
      <ComponentRef Id="StateFolder" />
      <ComponentRef Id="SettingEnrollmentKey" />
      <ComponentRef Id="SettingServerFingerprint" />
      <ComponentRef Id="SettingServerAddress" />
      <ComponentRef Id="SettingRoomName" />
      <ComponentRef Id="SettingAllowRemoteControl" />
      <ComponentRef Id="SettingShowViewingIndicator" />
    </Feature>
  </Package>
</Wix>
