<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    ClassInsight-Agent-Setup.exe: a standard Windows installer (WiX "Burn" bundle) wrapping
    ClassInsight.Agent.msi, so the agent can be installed by double-clicking one .exe.

    Build:   dotnet build -c Release            (from this folder; builds the MSI first)
    Output:  bin\x64\Release\ClassInsight-Agent-Setup.exe
    Install: double-click it (asks for admin), or silently:
             ClassInsight-Agent-Setup.exe /quiet /norestart
    Remove:  Settings > Apps > ClassInsight Agent, or ClassInsight-Agent-Setup.exe /uninstall /quiet
  -->
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>ClassInsight-Agent-Setup</OutputName>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassInsight.Agent.Installer.wixproj" />
  </ItemGroup>
</Project>
