<!--
  PROCTOR Agent MSI. Mirrors deploy\Install-Agent.ps1:
   * installs into %ProgramFiles%\PROCTOR (admin-only writable by default ACL),
   * registers the "PROCTORAgent" service: Automatic start, LocalSystem, restart on failure
     (5 s, 5 s, then 10 s; failure count reset daily) - FR-AGENT-02/07,
   * pre-creates %ProgramData%\PROCTOR (agent install id) with a protected ACL
     (Administrators/SYSTEM full, Users read) - FR-SEC-07,
   * adds a Windows Firewall rule letting the agent receive screen-share video (WebRTC, UDP)
     from PCs on the local subnet; removed again on uninstall,
   * upgrades in place (MajorUpgrade) and starts the service at the end of install.
  The service then launches the monitor inside the signed-in student's session (see README).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package Name="PROCTOR Agent"
           Manufacturer="PROCTOR"
           Version="$(var.ProctorVersion)"
           UpgradeCode="C383DD5C-4F49-4E09-B309-137E8FD973E7"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer PROCTOR Agent is already installed." />

    <!-- Icon in Settings > Apps. -->
    <Icon Id="ProctorIcon" SourceFile="$(sys.SOURCEFILEDIR)..\..\branding\proctor.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProctorIcon" />

    <!-- Install-time agent settings, e.g.
           msiexec /i PROCTOR.Agent.msi SERVERFINGERPRINT="1056 91B5 ..." SERVERADDRESS=10.0.0.5 /qn
         Each given value is written to proctor.ini next to the agent (read on top of
         appsettings.json) and remembered in HKLM\Software\PROCTOR\Agent, so a later upgrade
         run without the properties keeps them. -->
    <!-- Lab enrolment key (NFR-SEC-06): kept only in an admin-only registry key, never in a settings
         file students can read, and hidden from installer logs. -->
    <Property Id="ENROLLMENTKEY" Secure="yes" Hidden="yes" />
    <Property Id="SAVED_ENROLLMENTKEY" Hidden="yes">
      <RegistrySearch Id="FindEnrollmentKey" Root="HKLM" Key="Software\PROCTOR\Agent\Secret" Name="EnrollmentKey" Type="raw" />
    </Property>
    <SetProperty Id="ENROLLMENTKEY" Value="[SAVED_ENROLLMENTKEY]" After="AppSearch" Sequence="first"
                 Condition="NOT ENROLLMENTKEY AND SAVED_ENROLLMENTKEY" />
    <Property Id="SERVERFINGERPRINT" Secure="yes" />
    <Property Id="SAVED_SERVERFINGERPRINT">
      <RegistrySearch Id="FindServerFingerprint" Root="HKLM" Key="Software\PROCTOR\Agent" Name="ServerFingerprint" Type="raw" />
    </Property>
    <SetProperty Id="SERVERFINGERPRINT" Value="[SAVED_SERVERFINGERPRINT]" After="AppSearch" Sequence="first"
                 Condition="NOT SERVERFINGERPRINT AND SAVED_SERVERFINGERPRINT" />
    <Property Id="SERVERADDRESS" Secure="yes" />
    <Property Id="SAVED_SERVERADDRESS">
      <RegistrySearch Id="FindServerAddress" Root="HKLM" Key="Software\PROCTOR\Agent" Name="ServerAddress" Type="raw" />
    </Property>
    <SetProperty Id="SERVERADDRESS" Value="[SAVED_SERVERADDRESS]" After="AppSearch" Sequence="first"
                 Condition="NOT SERVERADDRESS AND SAVED_SERVERADDRESS" />
    <Property Id="ROOMNAME" Secure="yes" />
    <Property Id="SAVED_ROOMNAME">
      <RegistrySearch Id="FindRoomName" Root="HKLM" Key="Software\PROCTOR\Agent" Name="RoomName" Type="raw" />
    </Property>
    <SetProperty Id="ROOMNAME" Value="[SAVED_ROOMNAME]" After="AppSearch" Sequence="first"
                 Condition="NOT ROOMNAME AND SAVED_ROOMNAME" />
    <Property Id="ALLOWREMOTECONTROL" Secure="yes" />
    <Property Id="SAVED_ALLOWREMOTECONTROL">
      <RegistrySearch Id="FindAllowRemoteControl" Root="HKLM" Key="Software\PROCTOR\Agent" Name="AllowRemoteControl" Type="raw" />
    </Property>
    <SetProperty Id="ALLOWREMOTECONTROL" Value="[SAVED_ALLOWREMOTECONTROL]" After="AppSearch" Sequence="first"
                 Condition="NOT ALLOWREMOTECONTROL AND SAVED_ALLOWREMOTECONTROL" />
    <Property Id="SHOWVIEWINGINDICATOR" Secure="yes" />
    <Property Id="SAVED_SHOWVIEWINGINDICATOR">
      <RegistrySearch Id="FindShowViewingIndicator" Root="HKLM" Key="Software\PROCTOR\Agent" Name="ShowViewingIndicator" Type="raw" />
    </Property>
    <SetProperty Id="SHOWVIEWINGINDICATOR" Value="[SAVED_SHOWVIEWINGINDICATOR]" After="AppSearch" Sequence="first"
                 Condition="NOT SHOWVIEWINGINDICATOR AND SAVED_SHOWVIEWINGINDICATOR" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PROCTOR">

        <Component Id="AgentService" Guid="*">
          <File Id="AgentExe" Source="$(var.AgentDir)PROCTOR.Agent.exe" KeyPath="yes">
            <!-- The agent only dials out to the server, but WebRTC media (the teacher's broadcast,
                 remote control) arrives over UDP from other lab PCs. Scoped to this exe and the
                 local subnet; cross-subnet labs use a TURN relay (outbound) instead. -->
            <fw:FirewallException Id="AgentWebRtcUdp"
                                  Name="PROCTOR Agent (screen sharing)"
                                  Description="Lets the PROCTOR agent receive screen-share video from PCs on the local network."
                                  Protocol="udp"
                                  Scope="localSubnet"
                                  Profile="all" />
          </File>
          <ServiceInstall Id="AgentServiceInstall"
                          Name="PROCTORAgent"
                          DisplayName="PROCTOR Agent"
                          Description="PROCTOR classroom monitoring agent for institution-owned lab PCs."
                          Type="ownProcess"
                          Start="auto"
                          Account="LocalSystem"
                          ErrorControl="normal"
                          Vital="yes">
            <util:ServiceConfig FirstFailureActionType="restart"
                                SecondFailureActionType="restart"
                                ThirdFailureActionType="restart"
                                RestartServiceDelayInSeconds="5"
                                ResetPeriodInDays="1" />
          </ServiceInstall>
          <ServiceControl Id="AgentServiceControl"
                          Name="PROCTORAgent"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>

        <Component Id="AgentSettings" Guid="*" NeverOverwrite="yes">
          <!-- Per-lab settings (RoomName, ServerAddress, ...). NeverOverwrite keeps an admin's
               edits across upgrades. -->
          <File Id="AgentAppSettings" Source="$(var.AgentDir)appsettings.json" KeyPath="yes" />
        </Component>

        <Component Id="SettingEnrollmentKey" Condition="ENROLLMENTKEY">
          <RegistryKey Root="HKLM" Key="Software\PROCTOR\Agent\Secret" ForceCreateOnInstall="yes">
            <PermissionEx Sddl="O:BAG:SYD:PAI(A;;KA;;;SY)(A;;KA;;;BA)" />
            <RegistryValue Name="EnrollmentKey" Type="string" Value="[ENROLLMENTKEY]" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="SettingServerFingerprint" Condition="SERVERFINGERPRINT">
          <RegistryValue Root="HKLM" Key="Software\PROCTOR\Agent" Name="ServerFingerprint" Type="string" Value="[SERVERFINGERPRINT]" KeyPath="yes" />
          <IniFile Id="IniServerFingerprint" Action="addLine" Directory="INSTALLFOLDER" Name="proctor.ini"
                   Section="PROCTOR" Key="ServerFingerprint" Value="[SERVERFINGERPRINT]" />
        </Component>
        <Component Id="SettingServerAddress" Condition="SERVERADDRESS">
          <RegistryValue Root="HKLM" Key="Software\PROCTOR\Agent" Name="ServerAddress" Type="string" Value="[SERVERADDRESS]" KeyPath="yes" />
          <IniFile Id="IniServerAddress" Action="addLine" Directory="INSTALLFOLDER" Name="proctor.ini"
                   Section="PROCTOR" Key="ServerAddress" Value="[SERVERADDRESS]" />
        </Component>
        <Component Id="SettingRoomName" Condition="ROOMNAME">
          <RegistryValue Root="HKLM" Key="Software\PROCTOR\Agent" Name="RoomName" Type="string" Value="[ROOMNAME]" KeyPath="yes" />
          <IniFile Id="IniRoomName" Action="addLine" Directory="INSTALLFOLDER" Name="proctor.ini"
                   Section="PROCTOR" Key="RoomName" Value="[ROOMNAME]" />
        </Component>
        <Component Id="SettingAllowRemoteControl" Condition="ALLOWREMOTECONTROL">
          <RegistryValue Root="HKLM" Key="Software\PROCTOR\Agent" Name="AllowRemoteControl" Type="string" Value="[ALLOWREMOTECONTROL]" KeyPath="yes" />
          <IniFile Id="IniAllowRemoteControl" Action="addLine" Directory="INSTALLFOLDER" Name="proctor.ini"
                   Section="PROCTOR" Key="AllowRemoteControl" Value="[ALLOWREMOTECONTROL]" />
        </Component>
        <Component Id="SettingShowViewingIndicator" Condition="SHOWVIEWINGINDICATOR">
          <RegistryValue Root="HKLM" Key="Software\PROCTOR\Agent" Name="ShowViewingIndicator" Type="string" Value="[SHOWVIEWINGINDICATOR]" KeyPath="yes" />
          <IniFile Id="IniShowViewingIndicator" Action="addLine" Directory="INSTALLFOLDER" Name="proctor.ini"
                   Section="PROCTOR" Key="ShowViewingIndicator" Value="[SHOWVIEWINGINDICATOR]" />
        </Component>

      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="STATEFOLDER" Name="PROCTOR">
        <Component Id="StateFolder" Guid="1FD00634-6F2E-4EBA-95B3-914996C5C338">
          <CreateFolder>
            <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)(A;OICI;0x1200a9;;;BU)" />
          </CreateFolder>
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Agent" Title="PROCTOR Agent" Level="1">
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="AgentSettings" />
      <ComponentRef Id="StateFolder" />
      <ComponentRef Id="SettingEnrollmentKey" />
      <ComponentRef Id="SettingServerFingerprint" />
      <ComponentRef Id="SettingServerAddress" />
      <ComponentRef Id="SettingRoomName" />
      <ComponentRef Id="SettingAllowRemoteControl" />
      <ComponentRef Id="SettingShowViewingIndicator" />
    </Feature>
  </Package>
</Wix>
