<!--
  Setup .exe for the PROCTOR student agent. Shows the standard installer window
  (welcome / progress / finish), elevates once, and installs the MSI, which registers the
  auto-start "PROCTORAgent" service. Upgrades in place when a newer setup is run.

  Lab settings (server key, address, room, enrolment key, remote control) are passed to the MSI.
  They come from the command line (NAME=value, names in upper case) or are built in by
  installer\Build-AgentSetup.ps1; see LabSettings.wxi.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="PROCTOR Agent"
          Manufacturer="PROCTOR"
          Version="0.3.1"
          UpgradeCode="EA5BE157-0D61-474D-B200-D1AFB3963F61"
          AboutUrl="https://github.com/kennethtablang/PROCTORSystemMulti-ProjectApp">

    <BootstrapperApplication>
      <!-- No license page: the agent is deployed by the institution on its own machines. -->
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl="" ShowVersion="yes" />
    </BootstrapperApplication>

    <?include $(var.LabSettings)?>

    <Chain>
      <MsiPackage SourceFile="$(var.PROCTOR.Agent.Installer.TargetPath)"
                  Vital="yes"
                  Visible="no">
        <!-- Empty values are ignored by the MSI, which then keeps what an earlier install saved. -->
        <MsiProperty Name="SERVERFINGERPRINT" Value="[SERVERFINGERPRINT]" />
        <MsiProperty Name="SERVERADDRESS" Value="[SERVERADDRESS]" />
        <MsiProperty Name="ROOMNAME" Value="[ROOMNAME]" />
        <MsiProperty Name="ALLOWREMOTECONTROL" Value="[ALLOWREMOTECONTROL]" />
        <MsiProperty Name="SHOWVIEWINGINDICATOR" Value="[SHOWVIEWINGINDICATOR]" />
        <MsiProperty Name="ENROLLMENTKEY" Value="[ENROLLMENTKEY]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
