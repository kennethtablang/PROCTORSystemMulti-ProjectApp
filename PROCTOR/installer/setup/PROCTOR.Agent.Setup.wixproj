<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    PROCTOR-Agent-Setup.exe: a standard Windows installer (WiX "Burn" bundle) wrapping
    PROCTOR.Agent.msi, so the agent can be installed by double-clicking one .exe.

    Build:   dotnet build -c Release            (from this folder; builds the MSI first)
    Output:  bin\x64\Release\PROCTOR-Agent-Setup.exe
    Install: double-click it (asks for admin), or silently:
             PROCTOR-Agent-Setup.exe /quiet /norestart SERVERFINGERPRINT="1056 91B5 ..."
    For one lab: ..\Build-AgentSetup.ps1 builds a setup with the lab's settings built in.
    Remove:  Settings > Apps > PROCTOR Agent, or PROCTOR-Agent-Setup.exe /uninstall /quiet
  -->
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>PROCTOR-Agent-Setup</OutputName>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Lab settings built into the setup (Build-AgentSetup.ps1 passes a filled-in copy). -->
    <LabSettings Condition="'$(LabSettings)' == ''">$(MSBuildThisFileDirectory)LabSettings.wxi</LabSettings>
    <DefineConstants>$(DefineConstants);LabSettings=$(LabSettings);ProctorVersion=$(ProctorVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PROCTOR.Agent.Installer.wixproj" />
  </ItemGroup>
</Project>
