<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PROCTOR.Server</RootNamespace>
    <AssemblyName>PROCTOR.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs as the "PROCTORServer" Windows service (deploy\Install-Server.ps1); no-op in a console. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PROCTOR.Shared\PROCTOR.Shared.csproj" />
  </ItemGroup>

</Project>
