<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app's name, bundle id and version come from the .csproj (ApplicationTitle,
         ApplicationId, ProctorVersion) so they can't drift from the other platforms. -->
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- PROCTOR talks to the classroom server (and to student PCs over WebRTC) directly on the
         LAN. iOS asks the teacher for consent with this message (local network privacy). Sending a
         UDP discovery broadcast also needs Apple's com.apple.developer.networking.multicast
         entitlement; without it the app reaches the server through the servers it remembers
         (KnownServers) or an address typed once. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>PROCTOR connects to the classroom server and student computers on this network to show live student screens.</string>
    <!-- The hub is plain http/ws to a LAN IP; ATS does not apply to IP literals, and this covers
         .local / unqualified host names typed as a manual server address. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/AppIcon.appiconset</string>
</dict>
</plist>
