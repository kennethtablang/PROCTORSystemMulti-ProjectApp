<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-ios</TargetFramework>
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<RootNamespace>PROCTORSystemMulti_ProjectApp</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseMaui>true</UseMaui>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- The installed app. ApplicationId must match the App ID registered in the Apple developer
		     account (Build-iOSApp.sh -b overrides it if that one is taken). The version follows
		     ProctorVersion (Directory.Build.props); the build number must grow every release. -->
		<ApplicationId>com.proctor.teacher</ApplicationId>
		<ApplicationTitle>PROCTOR</ApplicationTitle>
		<ApplicationDisplayVersion>$(ProctorVersion)</ApplicationDisplayVersion>
		<ApplicationVersion>$(ProctorBuildNumber)</ApplicationVersion>

		<!-- Room discovery by UDP broadcast needs Apple's multicast entitlement, granted on request.
		     Off by default so the app signs with any account; -p:ProctorMulticast=true once granted. -->
		<CodesignEntitlements Condition="'$(ProctorMulticast)' == 'true'">Entitlements.Multicast.plist</CodesignEntitlements>
		<CodesignEntitlements Condition="'$(ProctorMulticast)' != 'true'">Entitlements.plist</CodesignEntitlements>
		<!-- The signed .ipa for iPhones/iPads is built on a Mac: PROCTOR\installer\Build-iOSApp.sh. -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PROCTORSystemMulti-ProjectApp\PROCTORSystemMulti-ProjectApp.csproj" />
	</ItemGroup>

</Project>
