<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PROCTORSystemMulti_ProjectApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PROCTORSystemMulti_ProjectApp"
    Shell.FlyoutBehavior="Disabled"
    Title="PROCTOR">

    <!-- One page: the dashboard (no tab strip). Per-student processes and bandwidth are in the
         student view's Live metrics panel. -->
    <ShellContent
        Title="Dashboard"
        ContentTemplate="{DataTemplate local:DashboardPage}"
        Route="Dashboard"
        Shell.TabBarIsVisible="False" />

</Shell>
