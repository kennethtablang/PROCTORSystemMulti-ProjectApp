<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PROCTORSystemMulti_ProjectApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PROCTORSystemMulti_ProjectApp"
    Shell.FlyoutBehavior="Disabled"
    Title="PROCTOR">

    <!-- Navbar: switch between the live views, all backed by one shared connection (FR-TEACH-03).
         Classroom control is a later tab. -->
    <TabBar>
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate local:DashboardPage}"
            Route="Dashboard" />

        <ShellContent
            Title="Processes"
            ContentTemplate="{DataTemplate local:ProcessesPage}"
            Route="Processes" />

        <ShellContent
            Title="Bandwidth"
            ContentTemplate="{DataTemplate local:BandwidthPage}"
            Route="Bandwidth" />
    </TabBar>

</Shell>
