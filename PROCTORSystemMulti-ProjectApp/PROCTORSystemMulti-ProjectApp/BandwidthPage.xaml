<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ci="clr-namespace:PROCTORSystemMulti_ProjectApp.ClassInsight"
             x:Class="PROCTORSystemMulti_ProjectApp.BandwidthPage"
             x:DataType="ci:DashboardViewModel"
             Shell.NavBarIsVisible="False"
             Title="Bandwidth">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="Network usage by student" FontAttributes="Bold" FontSize="16"
                   VerticalOptions="Center" />
            <Label Grid.Column="1" VerticalOptions="Center" FontAttributes="Bold" TextColor="Gray"
                   Text="{Binding StudentCount, StringFormat='{0} online'}" />
        </Grid>

        <!-- One row per student: live down/up + session totals, with a relative activity bar -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Students}">
            <CollectionView.EmptyView>
                <Label Text="No students connected yet."
                       HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ci:StudentTile">
                    <Border Stroke="#DDDDDD" StrokeThickness="1" Padding="12" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Header}" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding StateText}"
                                       TextColor="{Binding StateColor}" FontSize="12" FontAttributes="Bold" />
                            </Grid>

                            <!-- Download -->
                            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Dn" FontSize="11" TextColor="#1565C0"
                                       VerticalOptions="Center" />
                                <ProgressBar Grid.Column="1" Progress="{Binding DownloadBarFraction}"
                                             ProgressColor="#1565C0" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding DownloadRateText}" FontSize="12"
                                       WidthRequest="92" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>

                            <!-- Upload -->
                            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Up" FontSize="11" TextColor="#2E7D32"
                                       VerticalOptions="Center" />
                                <ProgressBar Grid.Column="1" Progress="{Binding UploadBarFraction}"
                                             ProgressColor="#2E7D32" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding UploadRateText}" FontSize="12"
                                       WidthRequest="92" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>

                            <Label Text="{Binding TotalsText}" FontSize="11" TextColor="#888888" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
