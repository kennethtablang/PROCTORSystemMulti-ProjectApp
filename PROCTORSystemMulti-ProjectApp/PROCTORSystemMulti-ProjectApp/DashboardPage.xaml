<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ci="clr-namespace:PROCTORSystemMulti_ProjectApp.PROCTOR"
             x:Class="PROCTORSystemMulti_ProjectApp.DashboardPage"
             x:DataType="ci:DashboardViewModel"
             Shell.NavBarIsVisible="False"
             Title="Dashboard">

    <Grid RowDefinitions="Auto,*" Padding="12,10" RowSpacing="8">

      <!-- Header panels stack without leaving gaps for the ones that are hidden. -->
      <VerticalStackLayout Grid.Row="0" Spacing="8">

        <!-- Server identity: first connection to a server, or its key changed (NFR-SEC-06). -->
        <Border IsVisible="{Binding NeedsServerTrust}" Stroke="{Binding TrustColor}" StrokeThickness="2" Padding="14,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding TrustTitle}" FontAttributes="Bold" FontSize="15" TextColor="{Binding TrustColor}" />
                <Label Text="{Binding TrustDetail}" FontSize="13" LineBreakMode="WordWrap" />
                <Label Text="{Binding TrustFingerprint}" FontFamily="Consolas" FontSize="14" FontAttributes="Bold" LineBreakMode="WordWrap" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="{Binding TrustButtonText}" Command="{Binding TrustServerCommand}"
                            BackgroundColor="{Binding TrustColor}" TextColor="White" />
                    <Button Text="Don't connect" Command="{Binding RejectServerCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Connect student PCs: the REAL address students must reach (connected server, else this
             PC's current LAN address; refreshed when the network changes), shown until a PC joins. -->
        <Border IsVisible="{Binding ShowConnectGuide}" Stroke="#B794F6" StrokeThickness="1" Padding="14,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding ConnectGuideTitle}" FontAttributes="Bold" FontSize="16" />

                <Label Text="Server address for student PCs" FontSize="12" TextColor="Gray" />
                <HorizontalStackLayout Spacing="10">
                    <Label Text="{Binding StudentServerAddress}" FontFamily="Consolas" FontSize="22"
                           FontAttributes="Bold" TextColor="#7E57C2" VerticalOptions="Center" />
                    <Button Text="Copy" Command="{Binding CopyServerAddressCommand}" Padding="10,2" FontSize="12"
                            VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="{Binding AddressSourceText}" FontSize="12" TextColor="Gray" LineBreakMode="WordWrap" />

                <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowStudentSteps}">
                <Label Text="Server key (fingerprint)" FontSize="12" TextColor="Gray" Margin="0,4,0,0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasServerKey}">
                    <Label Text="{Binding ServerKey}" FontFamily="Consolas" FontSize="14" FontAttributes="Bold"
                           TextColor="#7E57C2" VerticalOptions="Center" LineBreakMode="WordWrap" />
                    <Button Grid.Column="1" Text="Copy" Command="{Binding CopyServerKeyCommand}" Padding="10,2" FontSize="12"
                            VerticalOptions="Center" />
                </Grid>
                <Label Text="{Binding ServerKeyHint}" FontSize="12" TextColor="Gray" LineBreakMode="WordWrap" />

                <Label Text="How to connect" FontAttributes="Bold" FontSize="13" Margin="0,4,0,0" />
                <Label FontSize="13" LineBreakMode="WordWrap"
                       Text="1. The teacher PC runs the PROCTOR Classroom Service (installed with PROCTOR Teacher, starts with Windows)." />
                <Label FontSize="13" LineBreakMode="WordWrap"
                       Text="2. On each student PC, open Command Prompt as administrator in the folder with PROCTOR-Agent-Setup.exe and run:" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16,0,0,0">
                    <Label Text="{Binding SetupCommand}" FontFamily="Consolas" FontSize="13" VerticalOptions="Center"
                           LineBreakMode="CharacterWrap" />
                    <Button Grid.Column="1" Text="Copy" Command="{Binding CopySetupCommandCommand}" Padding="10,2" FontSize="12" />
                </Grid>
                <Label FontSize="13" LineBreakMode="WordWrap"
                       Text="3. Check from a student PC (PowerShell). It must say TcpTestSucceeded : True" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16,0,0,0">
                    <Label Text="{Binding TestCommand}" FontFamily="Consolas" FontSize="13" VerticalOptions="Center"
                           LineBreakMode="CharacterWrap" />
                    <Button Grid.Column="1" Text="Copy" Command="{Binding CopyTestCommandCommand}" Padding="10,2" FontSize="12" />
                </Grid>
                <Label FontSize="13" LineBreakMode="WordWrap"
                       Text="4. Test passes but the PC still isn't listed after a minute? On that PC open Event Viewer &gt; Windows Logs &gt; Application and look for source &quot;PROCTOR Agent&quot;: it says why (usually a different server key: uninstall PROCTOR Agent in Settings &gt; Apps on that PC, then run step 2 again)." />

                <Label Text="{Binding NetworkNote}" IsVisible="{Binding HasNetworkNote}" FontSize="12"
                       TextColor="#E65100" LineBreakMode="WordWrap" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Join code: revealed only when the room requires one (FR-SEC-02, §8). -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding NeedsJoinCode}">
            <Entry Grid.Column="0"
                   Placeholder="Join code (shown on the server console)"
                   Text="{Binding JoinCode}"
                   ReturnCommand="{Binding ConnectCommand}" />
            <Button Grid.Column="1" Text="Connect" Command="{Binding ConnectCommand}" />
        </Grid>

        <!-- Room chooser: several classrooms answered discovery (FR-DISC-04). -->
        <VerticalStackLayout Spacing="8" IsVisible="{Binding NeedsRoomChoice}">
            <Label Text="Several classrooms are on this network. Choose yours:" FontAttributes="Bold" />
            <FlexLayout BindableLayout.ItemsSource="{Binding Rooms}" Wrap="Wrap" JustifyContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="ci:RoomOption">
                        <Border Stroke="#B794F6" StrokeThickness="1" Padding="14,10" Margin="0,0,8,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectRoomCommand, Source={RelativeSource AncestorType={x:Type ci:DashboardViewModel}}, x:DataType=ci:DashboardViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Detail}" FontSize="11" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <!-- Manual server address: fallback when broadcast discovery is blocked (NFR-COMPAT-02). -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowManualEntry}">
            <Entry Grid.Column="0"
                   Placeholder="{Binding ManualAddressHint}"
                   Text="{Binding ManualAddress}"
                   ReturnCommand="{Binding ConnectManualCommand}" />
            <Button Grid.Column="1" Text="Connect" Command="{Binding ConnectManualCommand}" />
        </Grid>

        <!-- One toolbar row: every class action and teacher tool on the left (all visible, no
             "more" menu), view controls on the right (search, sort, stream quality, screen size,
             room). Status messages appear as a short-lived pill at the bottom right. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding IsConnected}">
            <!-- Shown whenever connected, so website lists and other limits can be set before students arrive. -->
            <FlexLayout Grid.Column="0" Wrap="Wrap" AlignItems="Center" AlignContent="Start">
                <ci:IconButton Glyph="{x:Static ci:Icons.Lock}" ToolTip="Lock all screens" Clicked="OnLockAll" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Unlock}" ToolTip="Unlock all screens" Clicked="OnUnlockAll" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Message}" ToolTip="Send a message to the class" Clicked="OnMessageAll" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Globe}" ToolTip="Open a website on every PC" Clicked="OnOpenSiteAll" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Screen}" ToolTip="Show my screen to the class" Clicked="OnShowScreen" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Poll}" ToolTip="Poll" Clicked="OnPoll" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Websites}" ToolTip="Websites: allow list (whitelist) or block list (blacklist)" Clicked="OnWebsites" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Limits}" ToolTip="Limits: programs, internet, sound" Clicked="OnLimits" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Power}" ToolTip="Log off, restart or shut down" Clicked="OnPowerAll" Margin="0,0,4,4" />
                <BoxView WidthRequest="1" HeightRequest="20" Color="#3A3E47" Margin="4,0,8,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Send}" ToolTip="Send files to the class" Clicked="OnSendFiles" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Collect}" ToolTip="Collect work (click again to stop collecting)" Clicked="OnCollectToggle" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Timer}" ToolTip="Lesson timer" Clicked="OnTimer" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Shuffle}" ToolTip="Pick a random student" Clicked="OnPick" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Camera}" ToolTip="Save snapshots of all screens" Clicked="OnSnapshot" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Attendance}" ToolTip="Export attendance (CSV)" Clicked="OnAttendance" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Key}" ToolTip="Teacher PIN" Clicked="OnPin" Margin="0,0,4,4" />
                <ci:IconButton Glyph="{x:Static ci:Icons.SignOut}" ToolTip="Lock this app now (needs a teacher PIN)" Clicked="OnLockApp" Margin="0,0,8,4" />
                <Label Text="{Binding PolicySummary}" FontSize="11" TextColor="#7E57C2" VerticalOptions="Center"
                       Margin="0,0,10,4" />
                <Label Text="{Binding PollBadge}" FontSize="11" TextColor="#2E7D32" FontAttributes="Bold"
                       VerticalOptions="Center" Margin="0,0,0,4" />
            </FlexLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Start">
                <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasStudents}">
                    <SearchBar Placeholder="Search" Text="{Binding SearchText}" WidthRequest="140"
                               ToolTipProperties.Text="Search name, user, app or site" />
                    <Picker ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" WidthRequest="96"
                            ToolTipProperties.Text="Sort by" />
                    <Picker ItemsSource="{Binding ThumbnailChoices}" SelectedIndex="{Binding ThumbnailSizeIndex}" WidthRequest="112"
                            ToolTipProperties.Text="Stream quality" />
                    <!-- Screen size: drag to make the student screens bigger or smaller (columns follow). -->
                    <Label Text="{x:Static ci:Icons.ZoomOut}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           VerticalOptions="Center" TextColor="#9AA0A6" />
                    <Slider Minimum="180" Maximum="960" Value="{Binding TileSize}" WidthRequest="90"
                            VerticalOptions="Center" ToolTipProperties.Text="Screen size"
                            SemanticProperties.Description="Student screen size" />
                    <Label Text="{x:Static ci:Icons.ZoomIn}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           VerticalOptions="Center" TextColor="#9AA0A6" Margin="0,0,4,0" />
                </HorizontalStackLayout>
                <Label Text="{Binding VisibleCountText}" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" />
                <Button Text="Switch room" Command="{Binding SwitchRoomCommand}" FontSize="11" VerticalOptions="Center"
                        BackgroundColor="Transparent" TextColor="#7E57C2" BorderColor="#B794F6" BorderWidth="1" />
                <ci:IconButton Glyph="{x:Static ci:Icons.Settings}" ToolTip="Settings" Clicked="OnSettings" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Lesson timer running -->
        <Border IsVisible="{Binding TimerRunning}" BackgroundColor="#EDE7F6" Stroke="#7E57C2" Padding="12,6">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding TimerText}" TextColor="#4527A0" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Stop timer" Clicked="OnStopTimer" Padding="12,2" FontSize="12"
                        BackgroundColor="#7E57C2" TextColor="White" />
            </Grid>
        </Border>

        <!-- File sending / collecting work -->
        <Border IsVisible="{Binding HasTransferText}" BackgroundColor="#E3F2FD" Stroke="#1565C0" Padding="12,6">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <Label Text="{Binding TransferText}" TextColor="#0D47A1" FontAttributes="Bold" FontSize="13"
                       VerticalOptions="Center" LineBreakMode="WordWrap" />
                <Button Grid.Column="1" Text="Open folder" Clicked="OnOpenCollectFolder" Padding="12,2" FontSize="12"
                        IsVisible="{Binding IsCollecting}" />
                <Button Grid.Column="2" Text="Stop collecting" Clicked="OnStopCollecting" Padding="12,2" FontSize="12"
                        BackgroundColor="#1565C0" TextColor="White" IsVisible="{Binding IsCollecting}" />
            </Grid>
        </Border>

        <!-- Screen broadcast in progress -->
        <Border IsVisible="{Binding IsBroadcasting}" BackgroundColor="#E8F5E9" Stroke="#2E7D32" Padding="12,6">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding BroadcastText}" TextColor="#1B5E20" FontAttributes="Bold" FontSize="13"
                       VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Stop showing" Clicked="OnStopShowScreen" Padding="12,2" FontSize="12"
                        BackgroundColor="#2E7D32" TextColor="White" />
            </Grid>
        </Border>

        <!-- Raised hands (students asking for help) — their tiles also float to the top. -->
        <Border IsVisible="{Binding HasRaisedHands}" BackgroundColor="#FFF4D6" Stroke="#F9A825" Padding="12,6">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label Text="{Binding RaisedHandsText}" TextColor="#7A5200" FontAttributes="Bold" FontSize="13" />
        </Border>

      </VerticalStackLayout>

        <!-- Live roster grid: every tile streams a thumbnail while this tab is visible (FR-STREAM-04). -->
        <CollectionView x:Name="TileGrid" Grid.Row="1" ItemsSource="{Binding VisibleStudents}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3"
                                 HorizontalItemSpacing="10" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyText}"
                       HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ci:StudentTile">
                    <Border Stroke="{Binding TileBorderColor}" StrokeThickness="2" Padding="8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTileTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                                <Label Grid.Column="0" Text="{Binding Header}" FontAttributes="Bold" FontSize="12"
                                       LineBreakMode="TailTruncation" />
                                <!-- Badges: raised hand (needs help), locked, unread chat. -->
                                <Label Grid.Column="1" Text="{x:Static ci:Icons.Help}" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" TextColor="#F9A825" VerticalOptions="Center" IsVisible="{Binding HandRaised}"
                                       ToolTipProperties.Text="Needs help" />
                                <Label Grid.Column="2" Text="{x:Static ci:Icons.Lock}" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" TextColor="#C62828" VerticalOptions="Center" IsVisible="{Binding IsLocked}"
                                       ToolTipProperties.Text="Locked" />
                                <Label Grid.Column="6" Text="{x:Static ci:Icons.Websites}" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" TextColor="#4FC3F7" VerticalOptions="Center" IsVisible="{Binding HasOwnWebLimits}"
                                       ToolTipProperties.Text="{Binding OwnWebLimitsText}" />
                                <Label Grid.Column="3" Text="{x:Static ci:Icons.Chat}" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" TextColor="#7E57C2" VerticalOptions="Center" IsVisible="{Binding HasUnreadChat}"
                                       ToolTipProperties.Text="Unread messages" />
                                <Label Grid.Column="4" Text="{Binding ChatBadge}" FontSize="10" TextColor="#7E57C2"
                                       FontAttributes="Bold" VerticalOptions="Center" IsVisible="{Binding HasUnreadChat}" />
                                <Label Grid.Column="5" Text="{Binding StateText}" TextColor="{Binding StateColor}"
                                       FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>

                            <!-- Live thumbnail: its height follows the Size slider (set in code-behind). -->
                            <Grid HeightRequest="{DynamicResource TileThumbHeight}">
                                <ci:LiveScreenView Source="{Binding Frame}" />
                                <Label Text="{Binding PlaceholderText}" TextColor="#AAAAAA" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                            </Grid>

                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding CpuText}" FontSize="11" />
                                <Label Text="{Binding MemoryText}" FontSize="11" />
                                <Label Text="{Binding BandwidthText}" FontSize="11" TextColor="#777777" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding ForegroundText}" FontSize="10" TextColor="#888888"
                                   LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Spacing="4" IsVisible="{Binding HasActiveHost}">
                                <Label Text="{x:Static ci:Icons.Globe}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       TextColor="#7E57C2" VerticalOptions="Center" />
                                <Label Text="{Binding ActiveHostText}" FontSize="10" TextColor="#7E57C2"
                                       LineBreakMode="TailTruncation" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!-- Status pill (e.g. "Connected to Classroom"): a notification at the bottom right for a few
             seconds after each message, and while the app is searching for the server. -->
        <Border Grid.Row="0" Grid.RowSpan="2" ZIndex="10" InputTransparent="True"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,4,4" Padding="10,5"
                BackgroundColor="#2A2D34" Stroke="#3A3E47" StrokeThickness="1"
                IsVisible="{Binding StatusVisible}" MaximumWidthRequest="520">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="6">
                <ActivityIndicator IsRunning="{Binding IsSearching}" IsVisible="{Binding IsSearching}"
                                   HeightRequest="12" WidthRequest="12" Color="#B794F6" />
                <Label Text="{Binding Status}" FontSize="11" TextColor="#E8EAED" VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
