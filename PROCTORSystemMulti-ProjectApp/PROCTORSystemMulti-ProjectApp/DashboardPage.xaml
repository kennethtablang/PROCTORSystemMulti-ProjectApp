<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ci="clr-namespace:PROCTORSystemMulti_ProjectApp.PROCTOR"
             x:Class="PROCTORSystemMulti_ProjectApp.DashboardPage"
             x:DataType="ci:DashboardViewModel"
             Shell.NavBarIsVisible="False"
             Title="Dashboard">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">

      <!-- Header panels stack without leaving gaps for the ones that are hidden. -->
      <VerticalStackLayout Grid.Row="0" Spacing="10">

        <!-- Server identity: first connection to a server, or its key changed (NFR-SEC-06). -->
        <Border IsVisible="{Binding NeedsServerTrust}" Stroke="{Binding TrustColor}" StrokeThickness="2" Padding="14,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding TrustTitle}" FontAttributes="Bold" FontSize="15" TextColor="{Binding TrustColor}" />
                <Label Text="{Binding TrustDetail}" FontSize="13" LineBreakMode="WordWrap" />
                <Label Text="{Binding TrustFingerprint}" FontFamily="Consolas" FontSize="14" FontAttributes="Bold" LineBreakMode="WordWrap" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="{Binding TrustButtonText}" Command="{Binding TrustServerCommand}"
                            BackgroundColor="{Binding TrustColor}" TextColor="White" />
                    <Button Text="Don't connect" Command="{Binding RejectServerCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Join code: revealed only when the room requires one (FR-SEC-02, §8). -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding NeedsJoinCode}">
            <Entry Grid.Column="0"
                   Placeholder="Join code (shown on the server console)"
                   Text="{Binding JoinCode}"
                   ReturnCommand="{Binding ConnectCommand}" />
            <Button Grid.Column="1" Text="Connect" Command="{Binding ConnectCommand}" />
        </Grid>

        <!-- Room chooser: several classrooms answered discovery (FR-DISC-04). -->
        <VerticalStackLayout Spacing="8" IsVisible="{Binding NeedsRoomChoice}">
            <Label Text="Several classrooms are on this network. Choose yours:" FontAttributes="Bold" />
            <FlexLayout BindableLayout.ItemsSource="{Binding Rooms}" Wrap="Wrap" JustifyContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="ci:RoomOption">
                        <Border Stroke="#B794F6" StrokeThickness="1" Padding="14,10" Margin="0,0,8,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectRoomCommand, Source={RelativeSource AncestorType={x:Type ci:DashboardViewModel}}, x:DataType=ci:DashboardViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Detail}" FontSize="11" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <!-- Manual server address: fallback when broadcast discovery is blocked (NFR-COMPAT-02). -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowManualEntry}">
            <Entry Grid.Column="0"
                   Placeholder="Server not found automatically? Enter its address, e.g. 192.168.1.20:5080"
                   Text="{Binding ManualAddress}"
                   ReturnCommand="{Binding ConnectManualCommand}" />
            <Button Grid.Column="1" Text="Connect" Command="{Binding ConnectManualCommand}" />
        </Grid>

        <!-- Status + view controls: search, sort, density (FR-TEACH-06). -->
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="8">
            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="10">
                <ActivityIndicator IsRunning="{Binding IsSearching}" IsVisible="{Binding IsSearching}"
                                   HeightRequest="16" WidthRequest="16" />
                <Label Text="{Binding Status}" FontSize="13" TextColor="Gray" VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="10" IsVisible="{Binding IsConnected}">
                <Label Text="{Binding VisibleCountText}" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Text="Switch room" Command="{Binding SwitchRoomCommand}" Padding="10,4"
                        FontSize="12" BackgroundColor="Transparent" TextColor="#7E57C2" BorderColor="#B794F6"
                        BorderWidth="1" />
            </HorizontalStackLayout>

            <FlexLayout Grid.Row="1" Grid.ColumnSpan="2" Wrap="Wrap" AlignItems="Center"
                        IsVisible="{Binding HasStudents}">
                <SearchBar Placeholder="Search name, user, app or site" Text="{Binding SearchText}"
                           WidthRequest="280" Margin="0,0,12,4" />
                <HorizontalStackLayout Spacing="6" Margin="0,0,12,4">
                    <Label Text="Sort" VerticalOptions="Center" FontSize="13" />
                    <Picker ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" WidthRequest="130" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6" Margin="0,0,12,4">
                    <Label Text="Thumbnails" VerticalOptions="Center" FontSize="13" />
                    <Picker ItemsSource="{Binding ThumbnailChoices}" SelectedIndex="{Binding ThumbnailSizeIndex}" WidthRequest="150" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6" Margin="0,0,0,4">
                    <Button Text="−" Command="{Binding FewerColumnsCommand}" WidthRequest="36" Padding="0" />
                    <Label Text="{Binding ColumnsText}" VerticalOptions="Center" FontSize="13" />
                    <Button Text="+" Command="{Binding MoreColumnsCommand}" WidthRequest="36" Padding="0" />
                </HorizontalStackLayout>
            </FlexLayout>
        </Grid>

        <!-- Class controls (P5): act on the whole class. Per-student actions live in the focus view. -->
        <FlexLayout Wrap="Wrap" AlignItems="Center" IsVisible="{Binding HasStudents}">
            <Label Text="Whole class:" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,8,4" />
            <Button Text="🔒 Lock" Clicked="OnLockAll" Margin="0,0,6,4" Padding="10,2" FontSize="12" />
            <Button Text="🔓 Unlock" Clicked="OnUnlockAll" Margin="0,0,6,4" Padding="10,2" FontSize="12" />
            <Button Text="✉ Message" Clicked="OnMessageAll" Margin="0,0,6,4" Padding="10,2" FontSize="12" />
            <Button Text="🌐 Open site" Clicked="OnOpenSiteAll" Margin="0,0,6,4" Padding="10,2" FontSize="12" />
            <Button Text="📺 Show my screen" Clicked="OnShowScreen" Margin="0,0,6,4" Padding="10,2" FontSize="12" />
            <Button Text="📊 Poll" Clicked="OnPoll" Margin="0,0,6,4" Padding="10,2" FontSize="12" />
            <Button Text="⛔ Limits…" Clicked="OnLimits" Margin="0,0,6,4" Padding="10,2" FontSize="12" />
            <Button Text="⏻ Power…" Clicked="OnPowerAll" Margin="0,0,6,4" Padding="10,2" FontSize="12" />
            <Button Text="⋯ More" Clicked="OnMore" Margin="0,0,12,4" Padding="10,2" FontSize="12" />
            <Label Text="{Binding PolicySummary}" FontSize="12" TextColor="#7E57C2" VerticalOptions="Center"
                   Margin="0,0,12,4" />
            <Label Text="{Binding PollBadge}" FontSize="12" TextColor="#2E7D32" FontAttributes="Bold"
                   VerticalOptions="Center" Margin="0,0,0,4" />
        </FlexLayout>

        <!-- Lesson timer running -->
        <Border IsVisible="{Binding TimerRunning}" BackgroundColor="#EDE7F6" Stroke="#7E57C2" Padding="12,6">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding TimerText}" TextColor="#4527A0" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Stop timer" Clicked="OnStopTimer" Padding="12,2" FontSize="12"
                        BackgroundColor="#7E57C2" TextColor="White" />
            </Grid>
        </Border>

        <!-- File sending / collecting work -->
        <Border IsVisible="{Binding HasTransferText}" BackgroundColor="#E3F2FD" Stroke="#1565C0" Padding="12,6">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <Label Text="{Binding TransferText}" TextColor="#0D47A1" FontAttributes="Bold" FontSize="13"
                       VerticalOptions="Center" LineBreakMode="WordWrap" />
                <Button Grid.Column="1" Text="Open folder" Clicked="OnOpenCollectFolder" Padding="12,2" FontSize="12"
                        IsVisible="{Binding IsCollecting}" />
                <Button Grid.Column="2" Text="Stop collecting" Clicked="OnStopCollecting" Padding="12,2" FontSize="12"
                        BackgroundColor="#1565C0" TextColor="White" IsVisible="{Binding IsCollecting}" />
            </Grid>
        </Border>

        <!-- Screen broadcast in progress -->
        <Border IsVisible="{Binding IsBroadcasting}" BackgroundColor="#E8F5E9" Stroke="#2E7D32" Padding="12,6">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding BroadcastText}" TextColor="#1B5E20" FontAttributes="Bold" FontSize="13"
                       VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Stop showing" Clicked="OnStopShowScreen" Padding="12,2" FontSize="12"
                        BackgroundColor="#2E7D32" TextColor="White" />
            </Grid>
        </Border>

        <!-- Raised hands (students asking for help) — their tiles also float to the top. -->
        <Border IsVisible="{Binding HasRaisedHands}" BackgroundColor="#FFF4D6" Stroke="#F9A825" Padding="12,6">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label Text="{Binding RaisedHandsText}" TextColor="#7A5200" FontAttributes="Bold" FontSize="13" />
        </Border>

      </VerticalStackLayout>

        <!-- Live roster grid: every tile streams a thumbnail while this tab is visible (FR-STREAM-04). -->
        <CollectionView x:Name="TileGrid" Grid.Row="1" ItemsSource="{Binding VisibleStudents}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3"
                                 HorizontalItemSpacing="12" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyText}"
                       HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ci:StudentTile">
                    <Border Stroke="{Binding TileBorderColor}" StrokeThickness="2" Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTileTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                <Label Grid.Column="0" Text="{Binding Header}" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="✋" FontSize="13" VerticalOptions="Center"
                                       IsVisible="{Binding HandRaised}" />
                                <Label Grid.Column="2" Text="{Binding LockText}" FontSize="11" TextColor="#C62828"
                                       FontAttributes="Bold" VerticalOptions="Center" IsVisible="{Binding IsLocked}" />
                                <Label Grid.Column="3" Text="{Binding ChatBadge}" FontSize="11" TextColor="#5B2C9E"
                                       FontAttributes="Bold" VerticalOptions="Center" IsVisible="{Binding HasUnreadChat}" />
                                <Label Grid.Column="4" Text="{Binding StateText}" TextColor="{Binding StateColor}"
                                       FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>

                            <!-- Live thumbnail -->
                            <Grid HeightRequest="140">
                                <ci:LiveScreenView Source="{Binding Frame}" />
                                <Label Text="{Binding PlaceholderText}" TextColor="#AAAAAA" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                            </Grid>

                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding CpuText}" FontSize="12" />
                                <Label Text="{Binding MemoryText}" FontSize="12" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding BandwidthText}" FontSize="12" TextColor="#555555" />
                            <Label Text="{Binding ForegroundText}" FontSize="11" TextColor="#888888"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding ActiveHostText}" FontSize="11" TextColor="#7E57C2"
                                   LineBreakMode="TailTruncation" IsVisible="{Binding HasActiveHost}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
