<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ci="clr-namespace:PROCTORSystemMulti_ProjectApp.ClassInsight"
             x:Class="PROCTORSystemMulti_ProjectApp.FocusPage"
             x:DataType="ci:StudentTile"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#101114">

    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*,Auto">

        <!-- Status / identity bar -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"
              Padding="16,10" BackgroundColor="#181A1F">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="{Binding Header}" FontAttributes="Bold" FontSize="16" TextColor="White"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding StreamStatus}" FontSize="12" TextColor="#9AA0A6" />
            </VerticalStackLayout>
            <!-- Which display to watch, for multi-monitor students (FR-AGENT-04). -->
            <Picker x:Name="DisplayPicker" Grid.Column="1" ItemsSource="{Binding DisplayLabels}"
                    IsVisible="{Binding HasMultipleDisplays}" WidthRequest="300" TextColor="White"
                    SelectedIndexChanged="OnDisplayChanged" />
            <Button Grid.Column="2" Text="Back" Clicked="OnStopClicked"
                    BackgroundColor="#2A2D34" TextColor="White" />
        </Grid>

        <!-- Per-student classroom controls (P5) -->
        <FlexLayout Grid.Row="1" Grid.ColumnSpan="2" Wrap="Wrap" AlignItems="Center" Padding="16,6"
                    BackgroundColor="#14161B">
            <Button Text="✋ Lower hand" Clicked="OnLowerHand" IsVisible="{Binding HandRaised}" Margin="0,0,8,4"
                    Padding="12,4" FontSize="13" BackgroundColor="#F9A825" TextColor="Black" />
            <Button Text="🔒 Lock" Clicked="OnLock" Margin="0,0,6,4" Padding="12,4" FontSize="13" />
            <Button Text="🔓 Unlock" Clicked="OnUnlock" Margin="0,0,6,4" Padding="12,4" FontSize="13" />
            <Button Text="✉ Message" Clicked="OnMessage" Margin="0,0,6,4" Padding="12,4" FontSize="13" />
            <Button Text="🌐 Open site" Clicked="OnOpenSite" Margin="0,0,6,4" Padding="12,4" FontSize="13" />
            <Button Text="⏻ Power…" Clicked="OnPower" Margin="0,0,12,4" Padding="12,4" FontSize="13" />
            <Label Text="{Binding LockText}" TextColor="#EF9A9A" FontAttributes="Bold" VerticalOptions="Center"
                   IsVisible="{Binding IsLocked}" Margin="0,0,0,4" />
        </FlexLayout>

        <!-- Live video surface (focus-quality stream, FR-TEACH-02) -->
        <Grid x:Name="VideoArea" Grid.Row="2" Grid.Column="0">
            <ci:LiveScreenView Source="{Binding Frame}" />
            <Label Text="{Binding PlaceholderText}" TextColor="#9AA0A6" FontSize="13"
                   HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
        </Grid>

        <!-- Live telemetry detail panel (CPU/RAM/bandwidth + processes). Moves under the video on
             narrow (phone) layouts — see SizeChanged in code-behind (NFR-USE-03). -->
        <Border x:Name="DetailPanel" Grid.Row="2" Grid.Column="1"
                WidthRequest="340" BackgroundColor="#15171C" Stroke="#23262D" StrokeThickness="0">
            <ScrollView Padding="14,12">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Live metrics" FontAttributes="Bold" FontSize="13" TextColor="#9AA0A6" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding CpuText}" FontSize="14" TextColor="White" />
                        <Label Text="{Binding MemoryText}" FontSize="14" TextColor="White" />
                        <Label Text="{Binding BandwidthText}" FontSize="13" TextColor="#C7CCD1" />
                        <Label Text="{Binding TotalsText}" FontSize="12" TextColor="#8A9096" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Foreground app" FontSize="11" TextColor="#9AA0A6" />
                        <Label Text="{Binding ForegroundText}" FontSize="13" TextColor="#E8EAED"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding ActiveHostText}" FontSize="12" TextColor="#B794F6"
                               IsVisible="{Binding HasActiveHost}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#23262D" />

                    <Label Text="Top processes" FontAttributes="Bold" FontSize="13" TextColor="#9AA0A6" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Processes}" Spacing="2">
                        <BindableLayout.EmptyView>
                            <Label Text="Waiting for telemetry…" FontSize="12" TextColor="#6B7177" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="ci:ProcessRow">
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,4" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                                        <Label Text="{Binding Name}" FontSize="13" TextColor="#E8EAED"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Pid}" FontSize="10" TextColor="#6B7177" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Cpu}" FontSize="12" TextColor="#F9A825"
                                           VerticalOptions="Center" WidthRequest="48" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding Mem}" FontSize="12" TextColor="#C7CCD1"
                                           VerticalOptions="Center" WidthRequest="70" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
