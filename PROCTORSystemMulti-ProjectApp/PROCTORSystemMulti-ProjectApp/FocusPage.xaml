<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="PROCTORSystemMulti_ProjectApp.FocusPage"
             Title="{Binding Title}"
             BackgroundColor="#101114">

    <Grid RowDefinitions="Auto,*">

        <!-- Status / identity bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,10" BackgroundColor="#181A1F">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label x:Name="HeaderLabel" FontAttributes="Bold" FontSize="16" TextColor="White" />
                <Label x:Name="StatusLabel" FontSize="12" TextColor="#9AA0A6" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Stop" Clicked="OnStopClicked"
                    BackgroundColor="#2A2D34" TextColor="White" />
        </Grid>

        <!-- Live video surface -->
        <skia:SKCanvasView x:Name="Canvas" Grid.Row="1" PaintSurface="OnPaintSurface" />
    </Grid>
</ContentPage>
