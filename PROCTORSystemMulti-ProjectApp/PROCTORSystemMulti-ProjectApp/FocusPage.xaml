<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:ci="clr-namespace:PROCTORSystemMulti_ProjectApp.ClassInsight"
             x:Class="PROCTORSystemMulti_ProjectApp.FocusPage"
             Title="{Binding Title}"
             BackgroundColor="#101114">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">

        <!-- Status / identity bar -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Padding="16,10" BackgroundColor="#181A1F">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label x:Name="HeaderLabel" FontAttributes="Bold" FontSize="16" TextColor="White" />
                <Label x:Name="StatusLabel" FontSize="12" TextColor="#9AA0A6" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Stop" Clicked="OnStopClicked"
                    BackgroundColor="#2A2D34" TextColor="White" />
        </Grid>

        <!-- Live video surface -->
        <skia:SKCanvasView x:Name="Canvas" Grid.Row="1" Grid.Column="0" PaintSurface="OnPaintSurface" />

        <!-- Live telemetry detail panel (CPU/RAM/bandwidth + processes) -->
        <Border x:Name="DetailPanel" Grid.Row="1" Grid.Column="1"
                WidthRequest="340" BackgroundColor="#15171C" Stroke="#23262D" StrokeThickness="0"
                x:DataType="ci:StudentTile">
            <ScrollView Padding="14,12">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Live metrics" FontAttributes="Bold" FontSize="13" TextColor="#9AA0A6" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding CpuText}" FontSize="14" TextColor="White" />
                        <Label Text="{Binding MemoryText}" FontSize="14" TextColor="White" />
                        <Label Text="{Binding BandwidthText}" FontSize="13" TextColor="#C7CCD1" />
                        <Label Text="{Binding TotalsText}" FontSize="12" TextColor="#8A9096" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Foreground app" FontSize="11" TextColor="#9AA0A6" />
                        <Label Text="{Binding ForegroundText}" FontSize="13" TextColor="#E8EAED"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#23262D" />

                    <Label Text="Top processes" FontAttributes="Bold" FontSize="13" TextColor="#9AA0A6" />

                    <CollectionView ItemsSource="{Binding Processes}">
                        <CollectionView.EmptyView>
                            <Label Text="Waiting for telemetry…" FontSize="12" TextColor="#6B7177" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="ci:ProcessRow">
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                                        <Label Text="{Binding Name}" FontSize="13" TextColor="#E8EAED"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Pid}" FontSize="10" TextColor="#6B7177" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Cpu}" FontSize="12" TextColor="#F9A825"
                                           VerticalOptions="Center" WidthRequest="48" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding Mem}" FontSize="12" TextColor="#C7CCD1"
                                           VerticalOptions="Center" WidthRequest="70" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
