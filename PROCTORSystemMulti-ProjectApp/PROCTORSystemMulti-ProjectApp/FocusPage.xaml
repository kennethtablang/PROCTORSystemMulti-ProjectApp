<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ci="clr-namespace:PROCTORSystemMulti_ProjectApp.PROCTOR"
             x:Class="PROCTORSystemMulti_ProjectApp.FocusPage"
             x:DataType="ci:StudentTile"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#101114">

    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*,Auto">

        <!-- Status / identity bar -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8"
              Padding="12,6" BackgroundColor="#181A1F">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="{Binding Header}" FontAttributes="Bold" FontSize="14" TextColor="White"
                       LineBreakMode="TailTruncation" />
                <Label x:Name="StreamInfo" FontSize="11" TextColor="#9AA0A6" />
            </VerticalStackLayout>
            <!-- Stream resolution for this view (remembered on this device). -->
            <Picker x:Name="ResolutionPicker" Grid.Column="1" WidthRequest="170" TextColor="White"
                    SelectedIndexChanged="OnResolutionChanged" />
            <!-- Which display to watch, for multi-monitor students (FR-AGENT-04). -->
            <Picker x:Name="DisplayPicker" Grid.Column="2" ItemsSource="{Binding DisplayLabels}"
                    IsVisible="{Binding HasMultipleDisplays}" WidthRequest="300" TextColor="White"
                    SelectedIndexChanged="OnDisplayChanged" />
            <!-- Show / hide the Live metrics panel (remembered). -->
            <ci:IconButton x:Name="MetricsButton" Grid.Column="3" Glyph="{x:Static ci:Icons.Pane}" ToolTip="Hide live metrics"
                           Clicked="OnToggleMetrics" BackgroundColor="#2A2D34" IconColor="White" />
            <ci:IconButton Grid.Column="4" Glyph="{x:Static ci:Icons.Back}" ToolTip="Back to the class"
                           Clicked="OnStopClicked" BackgroundColor="#2A2D34" IconColor="White" />
        </Grid>

        <!-- Per-student classroom controls (P5) -->
        <FlexLayout Grid.Row="1" Grid.ColumnSpan="2" Wrap="Wrap" AlignItems="Center" Padding="12,4"
                    BackgroundColor="#14161B">
            <ci:IconButton Glyph="{x:Static ci:Icons.Help}" ToolTip="Lower the student's hand" Clicked="OnLowerHand"
                           IsVisible="{Binding HandRaised}" Margin="0,0,8,4" BackgroundColor="#F9A825" IconColor="Black" />
            <ci:IconButton Glyph="{x:Static ci:Icons.Lock}" ToolTip="Lock screen" Clicked="OnLock" Margin="0,0,4,4" />
            <ci:IconButton Glyph="{x:Static ci:Icons.Unlock}" ToolTip="Unlock screen" Clicked="OnUnlock" Margin="0,0,4,4" />
            <ci:IconButton Glyph="{x:Static ci:Icons.Message}" ToolTip="Send a message" Clicked="OnMessage" Margin="0,0,4,4" />
            <ci:IconButton Glyph="{x:Static ci:Icons.Chat}" ToolTip="Chat" Clicked="OnChat" Margin="0,0,4,4" />
            <ci:IconButton Glyph="{x:Static ci:Icons.Send}" ToolTip="Send a file" Clicked="OnSendFile" Margin="0,0,4,4" />
            <ci:IconButton x:Name="ControlButton" Glyph="{x:Static ci:Icons.Control}" ToolTip="Take control (mouse and keyboard)"
                           Clicked="OnControl" Margin="0,0,4,4" />
            <!-- Phones/tablets: the on-screen keyboard types on the student's PC while in control. -->
            <ci:IconButton x:Name="KeyboardButton" Glyph="{x:Static ci:Icons.Keyboard}" ToolTip="Type on the student's PC"
                           Clicked="OnKeyboard" IsVisible="False" Margin="0,0,4,4" />
            <ci:IconButton Glyph="{x:Static ci:Icons.Globe}" ToolTip="Open a website" Clicked="OnOpenSite" Margin="0,0,4,4" />
            <ci:IconButton Glyph="{x:Static ci:Icons.Websites}" ToolTip="This student's websites: own allow / block list" Clicked="OnWebsites" Margin="0,0,4,4" />
            <ci:IconButton Glyph="{x:Static ci:Icons.Power}" ToolTip="Log off, restart or shut down" Clicked="OnPower" Margin="0,0,4,4" />
            <ci:IconButton Glyph="{x:Static ci:Icons.Camera}" ToolTip="Save a screenshot" Clicked="OnScreenshot" Margin="0,0,4,4" />
            <ci:IconButton Glyph="{x:Static ci:Icons.Reload}" ToolTip="Reload this screen (if it's black or frozen)" Clicked="OnReload" Margin="0,0,4,4" />
            <ci:IconButton Glyph="{x:Static ci:Icons.Screen}" ToolTip="Show this screen to the class" Clicked="OnShowToClass" Margin="0,0,12,4" />
            <Label Text="{x:Static ci:Icons.Lock}" FontFamily="{x:Static ci:Icons.FontFamily}" TextColor="#EF9A9A" FontSize="12"
                   VerticalOptions="Center" IsVisible="{Binding IsLocked}" Margin="0,0,4,4" />
            <Label Text="{Binding LockText}" TextColor="#EF9A9A" FontAttributes="Bold" FontSize="12" VerticalOptions="Center"
                   IsVisible="{Binding IsLocked}" Margin="0,0,10,4" />
            <Label Text="{Binding OwnWebLimitsText}" TextColor="#4FC3F7" FontSize="12" VerticalOptions="Center"
                   IsVisible="{Binding HasOwnWebLimits}" Margin="0,0,0,4" />
        </FlexLayout>

        <!-- Live video surface (focus-quality stream, FR-TEACH-02) -->
        <Grid x:Name="VideoArea" Grid.Row="2" Grid.Column="0">
            <ci:LiveScreenView x:Name="Screen" Source="{Binding Frame}" />
            <Label Text="{Binding PlaceholderText}" TextColor="#9AA0A6" FontSize="13"
                   HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
        </Grid>

        <!-- Live telemetry detail panel (CPU/RAM/bandwidth + processes). Moves under the video on
             narrow (phone) layouts — see SizeChanged in code-behind (NFR-USE-03). -->
        <Border x:Name="DetailPanel" Grid.Row="2" Grid.Column="1"
                WidthRequest="340" BackgroundColor="#15171C" Stroke="#23262D" StrokeThickness="0">
            <ScrollView Padding="14,12">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Live metrics" FontAttributes="Bold" FontSize="13" TextColor="#9AA0A6" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding CpuText}" FontSize="13" TextColor="White" />
                        <Label Text="{Binding MemoryText}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>

                    <!-- Bandwidth (was its own tab): live download / upload with bars, session totals. -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Bandwidth" FontAttributes="Bold" FontSize="12" TextColor="#9AA0A6" />
                        <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Dn" FontSize="11" TextColor="#64B5F6" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding DownloadBarFraction}" ProgressColor="#64B5F6"
                                         VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding DownloadRateText}" FontSize="12" TextColor="#E8EAED"
                                   WidthRequest="86" HorizontalTextAlignment="End" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Up" FontSize="11" TextColor="#81C784" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding UploadBarFraction}" ProgressColor="#81C784"
                                         VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding UploadRateText}" FontSize="12" TextColor="#E8EAED"
                                   WidthRequest="86" HorizontalTextAlignment="End" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding TotalsText}" FontSize="11" TextColor="#8A9096" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Foreground app" FontSize="11" TextColor="#9AA0A6" />
                        <Label Text="{Binding ForegroundText}" FontSize="13" TextColor="#E8EAED"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding ActiveHostText}" FontSize="12" TextColor="#B794F6"
                               IsVisible="{Binding HasActiveHost}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#23262D" />

                    <Label Text="Top processes" FontAttributes="Bold" FontSize="13" TextColor="#9AA0A6" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Processes}" Spacing="2">
                        <BindableLayout.EmptyView>
                            <Label Text="Waiting for telemetry…" FontSize="12" TextColor="#6B7177" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="ci:ProcessRow">
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,4" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                                        <Label Text="{Binding Name}" FontSize="13" TextColor="#E8EAED"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Pid}" FontSize="10" TextColor="#6B7177" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Cpu}" FontSize="12" TextColor="#F9A825"
                                           VerticalOptions="Center" WidthRequest="48" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding Mem}" FontSize="12" TextColor="#C7CCD1"
                                           VerticalOptions="Center" WidthRequest="70" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
