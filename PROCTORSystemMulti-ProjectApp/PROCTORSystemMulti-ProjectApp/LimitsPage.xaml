<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PROCTORSystemMulti_ProjectApp.LimitsPage"
             Title="Class limits">

    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="14" MaximumWidthRequest="760">

            <Label Text="Programs, internet, sound and flash drives for the whole class" FontSize="18" FontAttributes="Bold" />
            <Label Text="Applied to every student PC in this room, including students who join later. They are lifted automatically when the last teacher disconnects. Website lists (the Websites button) stay."
                   FontSize="12" TextColor="Gray" />

            <!-- App blocking -->
            <Label Text="Blocked programs" FontAttributes="Bold" FontSize="15" Margin="0,8,0,0" />
            <Editor x:Name="Apps" HeightRequest="90" AutoSize="Disabled"
                    Placeholder="One program per line, e.g.&#10;steam&#10;discord.exe" />
            <Label Text="Listed programs are closed when they start. Windows itself and PROCTOR can never be blocked."
                   FontSize="11" TextColor="Gray" />

            <!-- Program allow-list (whitelist) -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Only these programs (whitelist)" FontAttributes="Bold" FontSize="15" />
                    <Label Text="Any other program the student opens is closed at once. Windows itself (desktop, Start, File Explorer, sign-in), accessibility tools and PROCTOR always work."
                           FontSize="11" TextColor="Gray" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <Switch x:Name="AllowOnly" Grid.Column="1" VerticalOptions="Center" />
            </Grid>
            <Editor x:Name="Allowed" HeightRequest="90" AutoSize="Disabled" IsVisible="{Binding Source={x:Reference AllowOnly}, Path=IsToggled}"
                    Placeholder="One program per line: a name like Word, Excel, Chrome, Notepad, or the program file, e.g.&#10;code&#10;devenv.exe" />

            <!-- Internet / sound -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Turn off the internet" FontAttributes="Bold" FontSize="15" />
                    <Label Text="The lab network and PROCTOR keep working." FontSize="11" TextColor="Gray" />
                </VerticalStackLayout>
                <Switch x:Name="BlockInternet" Grid.Column="1" VerticalOptions="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Mute student sound" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                <Switch x:Name="Mute" Grid.Column="1" VerticalOptions="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Block flash drives" FontAttributes="Bold" FontSize="15" />
                    <Label Text="USB flash drives and memory cards stop working; ones already plugged in disappear. They work again when you turn this off."
                           FontSize="11" TextColor="Gray" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <Switch x:Name="BlockUsb" Grid.Column="1" VerticalOptions="Center" />
            </Grid>

            <Label x:Name="Error" TextColor="#C62828" IsVisible="False" />

            <HorizontalStackLayout Spacing="10" Margin="0,12,0,0">
                <Button Text="Apply" Clicked="OnApply" Padding="22,6" />
                <Button Text="Remove these limits" Clicked="OnClear" Padding="16,6" BackgroundColor="Transparent"
                        TextColor="#C62828" BorderColor="#C62828" BorderWidth="1" />
                <Button Text="Cancel" Clicked="OnCancel" Padding="16,6" BackgroundColor="Transparent"
                        TextColor="Gray" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
