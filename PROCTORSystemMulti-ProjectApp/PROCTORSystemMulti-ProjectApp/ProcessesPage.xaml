<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ci="clr-namespace:PROCTORSystemMulti_ProjectApp.ClassInsight"
             x:Class="PROCTORSystemMulti_ProjectApp.ProcessesPage"
             x:DataType="ci:DashboardViewModel"
             Shell.NavBarIsVisible="False"
             Title="Processes">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="Running processes by student" FontAttributes="Bold" FontSize="16"
                   VerticalOptions="Center" />
            <Label Grid.Column="1" VerticalOptions="Center" FontAttributes="Bold" TextColor="Gray"
                   Text="{Binding StudentCount, StringFormat='{0} online'}" />
        </Grid>

        <!-- One card per student, each listing that student's live top processes -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Students}">
            <CollectionView.EmptyView>
                <Label Text="No students connected yet."
                       HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ci:StudentTile">
                    <Border Stroke="#DDDDDD" StrokeThickness="1" Padding="12" Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Header}" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding CpuText}" FontSize="12"
                                       TextColor="#F9A825" />
                            </Grid>
                            <Label Text="{Binding ForegroundText}" FontSize="11" TextColor="#888888"
                                   LineBreakMode="TailTruncation" />

                            <!-- Column headings -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="0,2">
                                <Label Grid.Column="0" Text="Process" FontSize="11" TextColor="#9AA0A6" />
                                <Label Grid.Column="1" Text="CPU" FontSize="11" TextColor="#9AA0A6"
                                       WidthRequest="48" HorizontalTextAlignment="End" />
                                <Label Grid.Column="2" Text="Memory" FontSize="11" TextColor="#9AA0A6"
                                       WidthRequest="70" HorizontalTextAlignment="End" />
                            </Grid>

                            <!-- Live process rows (BindableLayout avoids nested-scroll conflicts) -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Processes}" Spacing="3">
                                <BindableLayout.EmptyView>
                                    <Label Text="Waiting for telemetry..." FontSize="12" TextColor="#AAAAAA" />
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="ci:ProcessRow">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Grid.Column="0" Spacing="0">
                                                <Label Text="{Binding Name}" FontSize="13"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Pid}" FontSize="10" TextColor="#AAAAAA" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Cpu}" FontSize="12"
                                                   VerticalOptions="Center" WidthRequest="48"
                                                   HorizontalTextAlignment="End" />
                                            <Label Grid.Column="2" Text="{Binding Mem}" FontSize="12"
                                                   TextColor="#555555" VerticalOptions="Center"
                                                   WidthRequest="70" HorizontalTextAlignment="End" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
